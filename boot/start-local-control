#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot starts this script after Android finishes booting.
set -eu

APP_DIR="$HOME/local-"
cd "$APP_DIR"
mkdir -p logs

if [ -f ".watchdog.pid" ]; then
  OLD_PID="$(cat .watchdog.pid 2>/dev/null || true)"
  if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
    OLD_CMD="$(tr '\0' ' ' < "/proc/$OLD_PID/cmdline" 2>/dev/null || true)"
    case "$OLD_CMD" in
      *watchdog.js*) echo "Local LAN Control is already running (PID $OLD_PID)."; exit 0 ;;
    esac
  fi
fi

if command -v termux-wake-lock >/dev/null 2>&1; then
  termux-wake-lock >/dev/null 2>&1 || true
fi

nohup sh "$APP_DIR/start.sh" >> "$APP_DIR/logs/supervisor.log" 2>&1 </dev/null &
echo "$!" > "$APP_DIR/.watchdog.pid"
echo "Local LAN Control supervisor started."
